{
  "name": "@vivekjha659/react-image-editor",
  "version": "0.1.0",
  "description": "A portable, WhatsApp-style image editor modal for React/Next.js apps (Konva-based text/shape layers + freehand drawing).",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/tailwind-entry.css -o ./dist/style.css --minify",
    "build:types": "node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "react-konva": "^18.0.0 || ^19.0.0",
    "konva": "^9.0.0 || ^10.0.0",
    "lucide-react": ">=0.300.0",
    "react-icons": "^5.0.0",
    "react-toastify": "^10.0.0"
  },
  "devDependencies": {
    "konva": "^9.3.22",
    "lucide-react": "^0.300.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-konva": "^18.2.16",
    "react-toastify": "^10.0.6",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}